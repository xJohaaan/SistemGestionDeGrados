<%--
    cabecera.jspf: <head>, menú lateral según el rol y barra superior de los paneles.
    Requiere antes del include:
        <c:set var="tituloPagina" value="Proyectos de"/>   texto del título
        <c:set var="resalte" value="GRADO"/>              (opcional) palabra resaltada en verde
        <c:set var="menu" value="inicio"/>                 opción del menú que se marca como activa
    Se cierra con pie.jspf.
--%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><c:out value="${tituloPagina}"/> <c:out value="${resalte}"/> | Trabajos de Grado UTS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link href="${ctx}/css/estilos.css" rel="stylesheet">
</head>
<body class="app">
<aside class="sidebar" id="sidebar">
    <div class="sidebar-marca">
        <a href="${ctx}/index.jsp" class="marca">
            <span class="marca-icono"><i class="bi bi-mortarboard-fill"></i></span>
            <span class="marca-texto">Ingeniería<br>de Sistemas<small>UTS</small></span>
        </a>
        <button class="btn btn-link d-lg-none text-secondary" type="button" data-toggle-sidebar aria-label="Cerrar menú"><i class="bi bi-x-lg"></i></button>
    </div>
    <nav class="sidebar-menu">
        <c:choose>
            <c:when test="${sessionScope.rol eq 'ADMIN'}">
                <a class="${menu eq 'inicio' ? 'activo' : ''}" href="${ctx}/admin/index.jsp"><i class="bi bi-house"></i> Inicio</a>
                <a class="${menu eq 'usuarios' ? 'activo' : ''}" href="${ctx}/admin/usuarios.jsp"><i class="bi bi-people"></i> Usuarios</a>
            </c:when>
            <c:when test="${sessionScope.rol eq 'COORDINACION'}">
                <a class="${menu eq 'inicio' ? 'activo' : ''}" href="${ctx}/coordinacion/index.jsp"><i class="bi bi-house"></i> Proyectos</a>
                <a class="${menu eq 'ideas' ? 'activo' : ''}" href="${ctx}/coordinacion/ideas.jsp"><i class="bi bi-lightbulb"></i> Banco de ideas</a>
                <a class="${menu eq 'asignar' ? 'activo' : ''}" href="${ctx}/coordinacion/asignar.jsp"><i class="bi bi-person-plus"></i> Asignar docentes</a>
                <a class="${menu eq 'comite' ? 'activo' : ''}" href="${ctx}/coordinacion/comite.jsp"><i class="bi bi-people"></i> Comité</a>
                <a class="${menu eq 'buscar' ? 'activo' : ''}" href="${ctx}/coordinacion/buscar.jsp"><i class="bi bi-search"></i> Buscar estudiante</a>
                <a class="${menu eq 'reportes' ? 'activo' : ''}" href="${ctx}/coordinacion/reportes.jsp"><i class="bi bi-bar-chart"></i> Reportes</a>
            </c:when>
            <c:when test="${sessionScope.rol eq 'DIRECTOR'}">
                <a class="${menu eq 'inicio' ? 'activo' : ''}" href="${ctx}/director/index.jsp"><i class="bi bi-person-workspace"></i> Docente Director</a>
                <a class="${menu eq 'banco' ? 'activo' : ''}" href="${ctx}/ideas/banco.jsp"><i class="bi bi-lightbulb"></i> Banco de ideas</a>
                <a class="${menu eq 'propuestas' ? 'activo' : ''}" href="${ctx}/ideas/mis_propuestas.jsp"><i class="bi bi-journal-plus"></i> Mis propuestas</a>
            </c:when>
            <c:when test="${sessionScope.rol eq 'EVALUADOR'}">
                <a class="${menu eq 'inicio' ? 'activo' : ''}" href="${ctx}/evaluador/index.jsp"><i class="bi bi-clipboard-check"></i> Docente Evaluador</a>
                <a class="${menu eq 'banco' ? 'activo' : ''}" href="${ctx}/ideas/banco.jsp"><i class="bi bi-lightbulb"></i> Banco de ideas</a>
                <a class="${menu eq 'propuestas' ? 'activo' : ''}" href="${ctx}/ideas/mis_propuestas.jsp"><i class="bi bi-journal-plus"></i> Mis propuestas</a>
            </c:when>
            <c:when test="${sessionScope.rol eq 'ESTUDIANTE'}">
                <a class="${menu eq 'inicio' ? 'activo' : ''}" href="${ctx}/estudiante/index.jsp"><i class="bi bi-house"></i> Seguimiento</a>
                <a class="${menu eq 'entregas' ? 'activo' : ''}" href="${ctx}/estudiante/entregas.jsp"><i class="bi bi-cloud-arrow-up"></i> Entregas</a>
                <a class="${menu eq 'miproyecto' ? 'activo' : ''}" href="${ctx}/estudiante/mi_proyecto.jsp"><i class="bi bi-journal-text"></i> Mi proyecto</a>
                <a class="${menu eq 'banco' ? 'activo' : ''}" href="${ctx}/ideas/banco.jsp"><i class="bi bi-lightbulb"></i> Banco de ideas</a>
                <a class="${menu eq 'propuestas' ? 'activo' : ''}" href="${ctx}/ideas/mis_propuestas.jsp"><i class="bi bi-journal-plus"></i> Mis propuestas</a>
            </c:when>
        </c:choose>
        <a class="${menu eq 'perfil' ? 'activo' : ''}" href="${ctx}/perfil.jsp"><i class="bi bi-person-badge"></i> Mi perfil</a>
        <a class="${menu eq 'documental' ? 'activo' : ''}" href="${ctx}/documental/index.jsp"><i class="bi bi-cloud-arrow-down"></i> Base documental</a>
    </nav>
</aside>
<div class="sidebar-fondo" data-toggle-sidebar></div>

<div class="contenido">
    <header class="topbar">
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-light d-lg-none" type="button" data-toggle-sidebar aria-label="Abrir menú"><i class="bi bi-list"></i></button>
            <span class="topbar-titulo">Bienvenido</span>
        </div>
        <div class="dropdown">
            <a class="usuario-menu dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="avatar"><i class="bi bi-person-fill"></i></span>
                <span class="d-none d-sm-inline">
                    <c:out value="${sessionScope.usuario.nombres}"/> <c:out value="${sessionScope.usuario.apellidos}"/>
                    <small class="d-block text-muted">
                        <c:choose>
                            <c:when test="${sessionScope.rol eq 'ADMIN'}">Administrador</c:when>
                            <c:when test="${sessionScope.rol eq 'COORDINACION'}">Coordinación</c:when>
                            <c:when test="${sessionScope.rol eq 'DIRECTOR'}">Docente Director</c:when>
                            <c:when test="${sessionScope.rol eq 'EVALUADOR'}">Docente Evaluador</c:when>
                            <c:otherwise>Estudiante</c:otherwise>
                        </c:choose>
                    </small>
                </span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li><a class="dropdown-item" href="${ctx}/perfil.jsp"><i class="bi bi-person-badge me-1"></i> Mi perfil</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item text-danger" href="${ctx}/logout.jsp"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</a></li>
            </ul>
        </div>
    </header>
    <main class="pagina">
        <h1 class="titulo-pagina"><c:out value="${tituloPagina}"/>
            <c:if test="${not empty resalte}"><span class="resalte"><c:out value="${resalte}"/></span></c:if>
        </h1>
        <%@ include file="/WEB-INF/jspf/alertas.jspf" %>
