<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">
    <display-name>SistemGestionDeGrados</display-name>
    <description>Sistema de Gestión de Trabajos de Grado - UTS (JSP + JSPF + JSTL, sin Maven, sin Servlets, sin scriptlets)</description>

    <!--
        ====== Conexión a MySQL ======
        La URL va aquí. El usuario y la contraseña (dbUser, dbPass) van en META-INF/context.xml,
        que NO se sube al repositorio. Copie META-INF/context.example.xml como context.xml y
        ponga sus credenciales.
    -->
    <context-param>
        <param-name>dbUrl</param-name>
        <param-value>jdbc:mysql://localhost:3306/gestion_grados?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=America/Bogota&amp;useUnicode=true&amp;characterEncoding=UTF-8&amp;useOldAliasMetadataBehavior=true</param-value>
    </context-param>

    <!-- ====== Filtro de autenticación/autorización por carpeta (no es un Servlet) ====== -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>co.edu.uts.grados.filtro.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
        <url-pattern>/coordinacion/*</url-pattern>
        <url-pattern>/director/*</url-pattern>
        <url-pattern>/evaluador/*</url-pattern>
        <url-pattern>/estudiante/*</url-pattern>
        <url-pattern>/documental/*</url-pattern>
        <url-pattern>/uploads/*</url-pattern>
        <url-pattern>/perfil.jsp</url-pattern>
        <url-pattern>/controlador_perfil.jsp</url-pattern>
    </filter-mapping>

    <!--
        Motor JSP propio de Tomcat (Jasper) con multipart habilitado para subir PDF
        desde las JSP con request.getPart(). No se escribe ningún Servlet.
    -->
    <servlet>
        <servlet-name>jsp</servlet-name>
        <servlet-class>org.apache.jasper.servlet.JspServlet</servlet-class>
        <init-param>
            <param-name>fork</param-name>
            <param-value>false</param-value>
        </init-param>
        <init-param>
            <param-name>xpoweredBy</param-name>
            <param-value>false</param-value>
        </init-param>
        <load-on-startup>3</load-on-startup>
        <multipart-config>
            <!-- 20 MB por archivo, 25 MB por petición -->
            <max-file-size>20971520</max-file-size>
            <max-request-size>26214400</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>jsp</servlet-name>
        <url-pattern>*.jsp</url-pattern>
    </servlet-mapping>

    <!-- ====== Prohíbe scriptlets: cualquier <% %> hace fallar la compilación ====== -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <scripting-invalid>true</scripting-invalid>
        </jsp-property-group>
        <!-- Los fragmentos incluidos también se leen en UTF-8 y tampoco admiten scriptlets -->
        <jsp-property-group>
            <url-pattern>*.jspf</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <scripting-invalid>true</scripting-invalid>
        </jsp-property-group>
    </jsp-config>

    <!-- Cierre automático de sesión por inactividad (minutos) -->
    <session-config>
        <session-timeout>20</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <!-- La sesión solo viaja en cookie, nunca como ;jsessionid en la URL -->
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>
</web-app>
